  FixedPointDatatypeOverride "1"
  InitializationCommands "V_g = 24; % Input voltage\nf_s = 360 * 10^2; % Switc"
"hing frequency\nT_dead = 100*10^-9; % Dead time\nL_blk = 4 * 10^-6; % Bulk in"
"ductance\nC_sc = 110; % Supercap capacitance\nR_on = 0; % On-state MOSFET res"
"istance\nd = 0.5; % duty cycle\nR_big = 10^5; % Balancing resistance\nR_esr ="
" 18*10^-3; \nL_esl = 1 * 10^-6;\nC_d = 10^-6;\n\nTs = 1/f_s;\nnum_cycles = 50"
"0000;\t\t% number of switch cycles to simulate\nmax_step_size = Ts/10;\t% max"
"imum time step size [s]\nTstop = num_cycles*Ts;\t% stop time of simulation [s"
"]"
