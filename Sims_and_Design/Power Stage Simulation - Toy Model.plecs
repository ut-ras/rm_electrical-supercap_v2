"3;   % On-state MOSFET resistance\nR_l = 77.13e-3;   % Inductor ESR\nR_esr = "
"18*10^-3; % Supercap resistance\nR = 2 * R_on + R_l + R_esr/4;\n\nL_blk = 28."
"306 * 10^-6; % Bulk inductance\nL = L_blk;\n\nC_sc = 110; % Supercap capacita"
"nce\nC = 4*C_sc;"
