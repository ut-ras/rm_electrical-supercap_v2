Plecs {
  Name          "Power Stage Simulation - Toy Model"
  Version       "5.0"
  CircuitModel  "ContStateSpace"
  StartTime     "0.0"
  TimeSpan      "100"
  Timeout       ""
  Solver        "auto"
  MaxStep       "1e-3"
  InitStep      "-1"
  FixedStep     "1e-3"
  Refine        "1"
  ZCStepSize    "1e-9"
  RelTol        "1e-3"
  AbsTol        "-1"
  TurnOnThreshold "0"
  NonIdealSwitchResistance "1"
  SyncFixedStepTasks "2"
  UseSingleCommonBaseRate "2"
  LossVariableLimitExceededMsg "3"
  NegativeSwitchLossMsg "3"
  DivisionByZeroMsg "3"
  DatatypeOverflowMsg "3"
  DatatypeInheritanceConflictMsg "2"
  ContSampleTimeConflictMsg "2"
  StiffnessDetectionMsg "2"
  MaxConsecutiveZCs "1000"
  AlgebraicLoopWithStateMachineMsg "3"
  AssertionAction "1"
  FixedPointDatatypeOverride "1"
  InitializationCommands "V_g = 24; % Nominal battery voltage\nfsw = 120e3; % "
"Switching frequency\nV_c0 = 0; % Initial supercapacitor voltage\n\nL_EMI = 2."
"3e-12;\nC_shunt = 10e-6;\n\nR_on = 0.35e-3;   % On-state MOSFET resistance\nR"
"_l = 77.13e-3;   % Inductor ESR\nR_esr = 18*10^-3; % Supercap resistance\nR ="
" 2 * R_on + R_l + R_esr/4;\n\nL_blk = 28.306 * 10^-6; % Bulk inductance\nL = "
"L_blk;\n\nC_sc = 110; % Supercap capacitance\nC = 4*C_sc; % Total capacitance"
"\n\ntau_i = 1/(2*pi*fsw/10); % Cutoff period\nkp_pi = L/tau_i; % proportional"
" gain [Ohms]\nki_pi = R/tau_i; % integral gain [F^-1]\n\nki2_pi2 = tau_i/(V_g"
"*C);\nkp_pi2 = L*C*ki2_pi2;\nki_pi2 = R*C*ki2_pi2;\n\ndith_lim = 0.01;"
  InitialState  "1"
  SystemState   ""
  JacobianComputation "2"
  TaskingMode   "1"
  TaskConfigurations ""
  CodeGenParameterInlining "2"
  CodeGenFloatingPointFormat "2"
  CodeGenAbsTimeUsageMsg "3"
  CodeGenBaseName ""
  CodeGenOutputDir ""
  CodeGenExtraOpts ""
  CodeGenTarget "Generic"
  CodeGenTargetSettings ""
  ExtendedMatrixPrecision "1"
  MatrixSignificanceCheck "2"
