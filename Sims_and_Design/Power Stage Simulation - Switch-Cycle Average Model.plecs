    Component {
      Type          Subsystem
      Name          "Transformer"
      Show          on
      Position      [190, 260]
      Direction     up
      Flipped       off
      LabelPosition south
      Frame         [-30, -30; 30, 30]
      SampleTime    "-1"
      CodeGenDiscretizationMethod "2"
      CodeGenTarget "Generic"
      MaskDisplay   "local X0=35\n"
"local Y0=20\n"
"local Xdelt=20\n"
"local Ydelt=6\n"
"local R = 3.5\n"
"\n"
"if Dialog:get('ext')=='2' then\n"
"    local Rg = 7.5\n"
"    local Rk = 2/3\n"
"    Xdelt = 15\n"
" --   Icon:circle(0,0,Rg)\n"
" --  Icon:line({-Rg*Rk, Rg*Rk},{ Rg*Rk,-Rg*Rk})\n"
" --   Icon:line({-Rg*Rk, Rg*Rk},{-Rg*Rk, Rg*Rk})\n"
"    \n"
"    Icon:color(0,180,0)\n"
"    Icon:line({0, 0},{-30, -Rg})\n"
"    Icon:color(0,0,0)\n"
"end\n"
"\n"
"\n"
"\n"
"Icon:line({-X0, -X0+Xdelt,-X0+Xdelt}, {Y0, Y0, Y0-Ydelt})\n"
"Icon:line({-X0, -X0+Xdelt,-X0+Xdelt}, {-Y0, -Y0, -Y0+Ydelt})\n"
"\n"
"Icon:circle(-X0+Xdelt,  -4*2*R,2)\n"
"Icon:arc(-X0+Xdelt,  1.5*2*R, R, R, 90, -180)\n"
"Icon:arc(-X0+Xdelt,  0.5*2*R, R, R, 90, -180)\n"
"Icon:arc(-X0+Xdelt, -0.5*2*R, R, R, 90, -180)\n"
"Icon:arc(-X0+Xdelt, -1.5*2*R, R, R, 90, -180)\n"
"\n"
"\n"
"Icon:line({ X0,  X0-Xdelt,X0-Xdelt}, {Y0, Y0, Y0-Ydelt})\n"
"Icon:line({ X0,  X0-Xdelt,X0-Xdelt}, {-Y0, -Y0, -Y0+Ydelt})\n"
"\n"
"Icon:circle(X0-Xdelt,  -4*2*R,2)\n"
"Icon:arc(X0-Xdelt,  1.5*2*R, R, R, 90, 180)\n"
"Icon:arc(X0-Xdelt,  0.5*2*R, R, R, 90, 180)\n"
"Icon:arc(X0-Xdelt, -0.5*2*R, R, R, 90, 180)\n"
"Icon:arc(X0-Xdelt, -1.5*2*R, R, R, 90, 180)\n"
"\n"
"\n"
"Icon:text('1:n(t)')\n"
"\n"
      MaskDisplayLang "2"
      MaskIconFrame off
      MaskIconOpaque off
      MaskIconRotates on
      MaskDialogCallback "Block:showTerminal('K', Dialog:get('ext')=='2')\n"
"Dialog:set('K', 'Visible', Dialog:get('ext')=='1')"
